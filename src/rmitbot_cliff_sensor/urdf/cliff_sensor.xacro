<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Macro for a Time-of-Flight (ToF) Cliff Sensor -->
    <xacro:macro name="cliff_sensor" params="name parent *origin">
        
        <!-- Joint to attach the cliff sensor -->
        <joint name="${name}_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}"/>
            <child link="${name}_link"/>
        </joint>

        <gazebo reference="${name}_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <!-- Cliff sensor link (visual representation) -->
        <link name="${name}_link">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.01"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.02 0.01"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
            </inertial>
        </link>

        <!-- Gazebo Sensor Definition for ROS 2 Jazzy (Gazebo Harmonic) -->
        <gazebo reference="${name}_link">
            <!-- Simulated as a GPU Lidar with a single ray (1x1 pixel) pointing straight down -->
            <sensor name="${name}_tof" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>sensors/cliff/${name}</topic>
                <gz_frame_id>${name}_link</gz_frame_id>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>5</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.235</min_angle>
                            <max_angle>0.235</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0.0</min_angle>
                            <max_angle>0.0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.01</min>
                        <max>1.5</max>
                        <resolution>0.005</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.005</stddev>
                    </noise>
                </ray>
            </sensor>
            <visual>
                <material>
                    <ambient>0.1 0.1 0.1 1.0</ambient>
                    <diffuse>0.1 0.1 0.1 1.0</diffuse>
                    <specular>0.1 0.1 0.1 1.0</specular>
                </material>
            </visual>
        </gazebo>

    </xacro:macro>
</robot>
